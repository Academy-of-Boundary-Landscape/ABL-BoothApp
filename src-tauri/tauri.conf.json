{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "摊盒",
  "version": "1.1.1",
  "identifier": "com.abl.BoothKernel",
  "build": {
    "beforeDevCommand": "npm run dev --prefix frontend",
    "beforeBuildCommand": "",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "security": {
      "csp": null,
      "capabilities": ["default"] 
    },  
    "windows": [
      {
        "label": "main",
        "title": "摊盒",
        "width": 1024,
        "height": 768,
        "resizable": true,
        "dragDropEnabled": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": true,
        "languages": ["SimpChinese", "English"]
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/Academy-of-Boundary-Landscape/ABL-BoothApp/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM1NkNFNDNDOTQ4NjMyMDcKUldRSE1vYVVQT1JzeFpkYWlZUGt4UndCUGY5QU5IeUp3K2w3dGI0dnlOVFpHOTZxT2ZrSTduc1MK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}