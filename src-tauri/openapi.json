  "paths": {
    "/channels": {
      "get": {
        "tags": [
          "settlement"
        ],
        "summary": "已用过的收款渠道，跨展会。",
        "description": "挂在 `/api/channels` 而不是 `/api/events/:id/channels`：它按定义就是跨展会的。\n这是防「微信」和「微信支付」分裂成两个账户的那一条（②-1/②-2 交接段第 3 条）。",
        "operationId": "list_channels",
        "responses": {
          "200": {
            "description": "预置渠道在前，历史用过的在后，去重",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "401": {
            "description": "未登录或令牌无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "无权访问这场展会",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
