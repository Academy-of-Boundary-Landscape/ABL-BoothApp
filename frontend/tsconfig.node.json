{
  "extends": "@tsconfig/node22/tsconfig.json",
  "include": ["vite.config.*", "eslint.config.*", "scripts/**/*"],
  "exclude": ["scripts/fixtures/**"],
  "compilerOptions": {
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo"
  }
}
