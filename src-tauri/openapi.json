  "components": {
    "schemas": {
      "AdjustmentRequest": {
        "type": "object",
        "required": [
          "society_id",
          "label",
          "direction",
          "amount"
        ],
        "properties": {
          "amount": {
            "$ref": "#/components/schemas/Money",
            "description": "分，必须为正。符号由 `direction` 决定。"
          },
          "direction": {
            "type": "string",
            "description": "`to_them` = 我要多给他们；`to_me` = 他们要多给我。\n\n**界面不给摊主填正负号。** 母 spec 5.2 那个例子自己都要算一遍才对得上\n方向，让人在收摊后的疲惫状态下判断「赔付该填正还是负」是设计失误。"
          },
          "label": {
            "type": "string"
          },
          "society_id": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "AdvanceRequest": {
        "type": "object",
        "required": [
          "society_id",
          "label",
          "amount"
        ],
        "properties": {
          "amount": {
            "$ref": "#/components/schemas/Money",
            "description": "分，必须为正。方向是固定的（摊主掏钱给社团），不需要符号。"
          },
          "label": {
            "type": "string"
          },
          "society_id": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "ApiErrorBody": {
        "type": "object",
        "description": "所有错误响应的形状。为什么必须是这个形状，见 `crate::error` 的模块注释。",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "ChannelActual": {
        "type": "object",
        "required": [
          "channel",
          "actual"
        ],
        "properties": {
          "actual": {
            "$ref": "#/components/schemas/Money",
            "description": "摊主数出来的实际到手（分）。"
          },
          "channel": {
            "type": "string"
          }
        }
      },
      "ChannelLine": {
        "type": "object",
        "required": [
          "channel",
          "book",
          "actual",
          "diff",
          "counted"
        ],
        "properties": {
          "actual": {
            "$ref": "#/components/schemas/Money"
          },
          "book": {
            "$ref": "#/components/schemas/Money"
          },
          "channel": {
            "type": "string"
          },
          "counted": {
            "type": "boolean"
          },
          "diff": {
            "$ref": "#/components/schemas/Money"
          }
        }
      },
      "CreatedEntry": {
        "type": "object",
        "required": [
          "id",
          "journal_id"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "journal_id": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "GoodsLine": {
        "type": "object",
        "description": "一个商品在一场展会里的全部去向。**每一项都从 `stock_movements` 按方向取**，\n没有任何缓存字段——母 spec 的整个设计就是「不存在第二个可以漂移的数字」。",
        "required": [
          "event_product_id",
          "product_code",
          "name",
          "brought_in",
          "sold",
          "gifted",
          "scrapped",
          "variance",
          "taken_back",
          "on_site",
          "gross",
          "lot_discount",
          "allocated"
        ],
        "properties": {
          "allocated": {
            "$ref": "#/components/schemas/Money",
            "description": "货主应得（已扣除退货部分）。**用 allocated 不用 paid。**"
          },
          "brought_in": {
            "type": "integer",
            "format": "int64",
            "description": "`外部 → 现场仓` 的合计。开场带货和中途补货是同一件事。"
          },
          "event_product_id": {
            "type": "integer",
            "format": "int64"
          },
          "gifted": {
            "type": "integer",
            "format": "int64"
          },
          "gross": {
            "$ref": "#/components/schemas/Money",
            "description": "这个商品的原价合计（已扣除退货部分）。spec 8.4 要求「货主明细」按商品列出金额——\n只给数量等于让社团自己去乘单价，而 Lot 折让之后单价不等于成交价。"
          },
          "lot_discount": {
            "$ref": "#/components/schemas/Money",
            "description": "Lot 折让 = gross − allocated。"
          },
          "name": {
            "type": "string"
          },
          "on_site": {
            "type": "integer",
            "format": "int64",
            "description": "还在现场仓的。走完带回之后必须是 0。"
          },
          "product_code": {
